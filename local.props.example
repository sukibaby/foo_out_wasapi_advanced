<?xml version="1.0" encoding="utf-8"?>
<!--
  Optional: copy this file to local.props (same folder as the .vcxproj) to build from the
  Visual Studio IDE without passing paths. build.bat does not need it - it passes the paths
  on the MSBuild command line. Paths must NOT end with a backslash.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Fb2kSdkRoot>C:\path\to\foobar-SDK-2026-10-01</Fb2kSdkRoot>
    <WtlRoot>C:\path\to\WTL10_01_Release</WtlRoot>
    <!-- For IDE builds when the selected toolset has no ATL of its own. -->
    <AtlInclude>C:\Program Files\Microsoft Visual Studio\18\Community\VC\Tools\MSVC\14.51.36231\atlmfc\include</AtlInclude>
    <!-- Folder containing atls.lib for the selected platform. For ARM64EC, this may be
         ...\atlmfc\lib\spectre\arm64; build-all.bat finds and passes the appropriate folder. -->
    <AtlLibraryDir>C:\Program Files\Microsoft Visual Studio\18\Community\VC\Tools\MSVC\14.51.36231\atlmfc\lib\arm64</AtlLibraryDir>
  </PropertyGroup>
</Project>
